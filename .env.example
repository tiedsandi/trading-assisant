## Docker Compose
COMPOSE_PROJECT_NAME=trading-assistant

## Toolchain versions used by the development images
BUN_VERSION=1.4.2
GO_VERSION=1.27.1
AIR_VERSION=v1.67.3

## Ports exposed only on this computer
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432

## PostgreSQL (local development only)
# Keep this value URL-safe because Compose also places it in DATABASE_URL.
POSTGRES_DB=trading_assistant
POSTGRES_USER=trading_assistant
POSTGRES_PASSWORD=trading_assistant_dev

## Backend
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000

## Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
INTERNAL_API_URL=http://backend:8080
WATCHPACK_POLLING=true
